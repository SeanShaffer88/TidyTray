{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TidyTray",
  "mainBinaryName": "TidyTray",
  "version": "1.0.0",
  "identifier": "com.tidytray.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TidyTray",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "PC cleanup and health monitor",
    "copyright": "Copyright (c) 2026 TidyTray contributors"
  }
}
